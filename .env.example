# Web&Shop / InventoryLens - environment template
#
# Copy to .env and fill in. .env is gitignored (.gitignore:10-12); .env.example is tracked.
# NOTE: this project has no python-dotenv loader yet, so nothing reads .env automatically.
#       Either export these in your shell, or ask for a loader to be added to the app.
#
# NOTHING BELOW IS REQUIRED TO RUN THE LOCAL APP OR THE TEST SUITE (106/106 pass without any of it).
# Each entry says what it unlocks and whether it is a secret.


# ─────────────────────────────────────────────────────────────────────
# 1. AWS  -  NO API KEYS NEEDED. Do not put AWS access keys here.
# ─────────────────────────────────────────────────────────────────────
# This is a "new AWS experience" project: you authenticate with
#     aws login --profile "WEB&SHOP"
# which uses social sign-in, not long-lived keys. The profile name is a literal
# used in code (upload_manifest.py:17) - do not rename it.
# Only the region is a plain value:
AWS_REGION=eu-north-1

# The AWS CLI is NOT installed on this machine. Install AWS CLI v2 to use any AWS path.


# ─────────────────────────────────────────────────────────────────────
# 2. Model downloads  -  OPTIONAL
# ─────────────────────────────────────────────────────────────────────
# SigLIP2 (google/siglip2-base-patch16-224) is PUBLIC Apache-2.0 and needs no token.
# A token only raises download rate limits. SECRET - keep private.
HUGGINGFACE_HUB_TOKEN=

# Where to cache HuggingFace model downloads (~1.5 GB for SigLIP2). Path, not a secret.
WEBSHOP_HF_CACHE=

# NVIDIA NGC, for the Retail DINO detector (retail_object_detection v2.2.2.3).
# Guest access may be enough; a key is needed only if the org requires sign-in. SECRET.
# NOTE: this model is TensorRT-only (12 MultiscaleDeformableAttnPlugin_TRT nodes)
#       and CANNOT run on CPU - downloading it does not unblock a local run.
NGC_API_KEY=

# Meta DINOv3 - gated weights you must obtain from Meta yourself. Paths, not secrets.
DINOV3_WEIGHTS=
DINOV3_REPO=

# Local SKU110K YOLO11n weights override. Path, not a secret.
INVENTORYLENS_SKU110K_WEIGHTS=


# ─────────────────────────────────────────────────────────────────────
# 3. Optional GPU compute  -  ONLY IF YOU AUTHORIZE IT (costs money)
# ─────────────────────────────────────────────────────────────────────
# AWS EC2 G/VT quota is 0 vCPUs and the increase was DENIED on 2026-10-20,
# so RunPod is currently the only route to a GPU run. It is NOT authorized yet
# and bills by the second. SECRET.
RUNPOD_API_KEY=


# ─────────────────────────────────────────────────────────────────────
# 4. Tooling  -  OPTIONAL, developer convenience
# ─────────────────────────────────────────────────────────────────────
# Gemini key for graphify semantic extraction. Without it, extraction runs through
# the agent session instead (slower and more token-expensive). SECRET.
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # alternative name for the same thing


# ─────────────────────────────────────────────────────────────────────
# 5. NOT a .env variable  -  set these elsewhere
# ─────────────────────────────────────────────────────────────────────
# CLAUDE_API_KEY  ->  GitHub repository secret, for .github/workflows/security.yml
#                     Set at: Settings > Secrets and variables > Actions > New secret
#                     It must NOT go in this file.
